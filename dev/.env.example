# Copy to .env and adjust if your repos are not siblings of duly-infra.
#
# Compose resolves relative paths against this directory, not your shell's cwd,
# so the defaults assume the layout checked out by `git clone` side by side:
#
#   note-taking-app/
#     duly-backend/
#     duly-chat-backend/
#     duly-frontend/
#     embedder-qa/
#     duly-infra/dev/   <- you are here
#
# Every service builds from the working tree rather than a registry image, so
# these point at source you are editing. Absolute paths are fine.

DULY_BACKEND_PATH=../../duly-backend
DULY_CHAT_BACKEND_PATH=../../duly-chat-backend
DULY_FRONTEND_PATH=../../duly-frontend
EMBEDDER_QA_PATH=../../embedder-qa

# duly-backend's bind-mounted src is written to by the container (bytecode, and
# alembic revisions if you generate them there), so the uid must match yours or
# the files land owned by root. `id -u` and `id -g`. UID and GID are shell
# parameters and are not exported, so compose cannot read them without this.
UID=1
GID=1
