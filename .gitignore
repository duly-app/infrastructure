# Terraform state and backups
*.tfstate
*.tfstate.*

# Terraform cache (regenerated by terraform init)
.terraform/

# Local Terraform overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log

# Exclude all .tfvars files (sensitive)
*.tfvars
*.tfvars.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files
*.tfplan

# tflint. The config itself is committed, so CI lints with the same ruleset as
# you do; only the plugin cache it downloads is ignored.
.tflint.d/

# Local dev overrides (repo paths, uid/gid)
dev/.env
!dev/.env.example

# The real Anthropic key, consumed by `make secrets`
k8s/chatbot/anthropic.env
